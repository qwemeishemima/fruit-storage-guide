page {
  min-height: 100vh;
  background: #f7fbf4;
  color: #243126;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 48rpx;
}

.section-title {
  margin: 0 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #243126;
}

.muted-text {
  color: #7f8a7b;
  font-size: 26rpx;
  line-height: 1.6;
}

.card {
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #fffdf7;
  box-shadow: 0 12rpx 32rpx rgba(63, 143, 90, 0.08);
}
