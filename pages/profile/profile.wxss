.profile-page {
  padding-top: 40rpx;
}

.profile-hero,
.overview-card,
.info-card,
.notice-card {
  padding: 32rpx 30rpx;
}

.profile-hero {
  background: #fffdf7;
}

.brand {
  color: #2f7d4f;
  font-size: 48rpx;
  font-weight: 800;
}

.slogan {
  margin-top: 10rpx;
  color: #315d3c;
  font-size: 28rpx;
  font-weight: 600;
}

.hero-desc {
  margin-top: 14rpx;
  color: #59685b;
  font-size: 26rpx;
  line-height: 1.5;
}

.overview-card,
.info-card,
.notice-card {
  margin-top: 28rpx;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.overview-item {
  min-width: 0;
  padding: 20rpx 8rpx;
  border-radius: 20rpx;
  background: #f7fbf4;
  text-align: center;
}

.overview-item.attention {
  background: #fff4ec;
}

.overview-number {
  color: #243126;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
}

.overview-label {
  margin-top: 8rpx;
  color: #7f8a7b;
  font-size: 24rpx;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-index {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf5e9;
  color: #315d3c;
  font-size: 24rpx;
  font-weight: 700;
}

.step-text,
.about-text,
.notice-text {
  color: #59685b;
  font-size: 27rpx;
  line-height: 1.6;
}

.notice-card {
  background: #fffdf4;
}

.notice-title {
  margin-bottom: 10rpx;
  color: #315d3c;
  font-size: 28rpx;
  font-weight: 700;
}

.danger-area {
  padding: 34rpx 0 8rpx;
  text-align: center;
}

.clear-button {
  display: inline-flex;
  min-width: 240rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ead8d2;
  border-radius: 999rpx;
  background: #fff8f5;
  color: #9b3d32;
  font-size: 26rpx;
  line-height: 72rpx;
}

.clear-button::after {
  border: 0;
}

.clear-button:active {
  background: #f7ece8;
}
