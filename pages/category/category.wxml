<view class="page category-page">
  <view class="section-title">分类</view>

  <view class="category-grid">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-card card {{item.isActive ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >
      <view class="category-main">
        <view class="category-icon" style="background: {{item.color}};">{{item.icon}}</view>
        <view class="category-name">{{item.name}}</view>
      </view>
      <view class="category-desc">{{item.desc}}</view>
    </view>
  </view>

  <view wx:if="{{activeCategory}}" class="food-section">
    <view class="food-section-title">{{activeCategory.name}}</view>

    <view wx:if="{{!hasFoods}}" class="empty-card card">
      <view class="muted-text">这个分类还没有食材</view>
    </view>

    <view wx:if="{{hasFoods}}" class="food-list">
      <view
        wx:for="{{foods}}"
        wx:key="id"
        class="food-card card"
        data-id="{{item.id}}"
        bindtap="goToDetail"
      >
        <view class="food-name">{{item.name}}</view>
        <view class="food-summary">{{item.summary}}</view>
        <view class="tag-row">
          <view wx:for="{{item.visibleTags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
