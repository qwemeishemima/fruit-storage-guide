.detail-page {
  padding-top: 32rpx;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.empty-card {
  padding: 48rpx 32rpx;
  text-align: center;
}

.detail-hero {
  padding: 38rpx 34rpx 34rpx;
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-meta {
  color: #7f8a7b;
  font-size: 24rpx;
}

.food-title {
  margin-top: 10rpx;
  color: #243126;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.18;
}

.hero-summary {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-left: 6rpx solid #72a66f;
  border-radius: 14rpx;
  background: #f3f9ef;
  color: #315d3c;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eaf5e9;
  color: #315d3c;
  font-size: 23rpx;
}

.info-card {
  margin-top: 20rpx;
  padding: 26rpx 28rpx 24rpx;
}

.card-title {
  margin-bottom: 16rpx;
  color: #243126;
  font-size: 31rpx;
  font-weight: 700;
}

.fridge-advice {
  padding: 18rpx 20rpx;
  border: 1rpx solid #d9ebd4;
  border-radius: 18rpx;
  background: #fbfef8;
}

.fridge-advice-value {
  margin-top: 8rpx;
  color: #243126;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.55;
}

.shelf-life-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.shelf-life-item {
  flex: 0 0 calc((100% - 16rpx) / 2);
  min-width: 0;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f8fbf4;
}

.shelf-life-value {
  margin-top: 8rpx;
  color: #243126;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.info-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.info-item {
  padding: 17rpx 20rpx;
  border-radius: 18rpx;
  background: #f8fbf4;
}

.info-label {
  color: #7f8a7b;
  font-size: 23rpx;
  line-height: 1.3;
}

.info-value {
  margin-top: 8rpx;
  color: #243126;
  font-size: 29rpx;
  line-height: 1.6;
}

.tips-group {
  margin-top: 18rpx;
}

.info-grid + .tips-group {
  margin-top: 22rpx;
}

.tips-title {
  margin-bottom: 6rpx;
  color: #7f8a7b;
  font-size: 23rpx;
  line-height: 1.3;
}

.tip-item {
  position: relative;
  padding: 10rpx 0 10rpx 30rpx;
  color: #243126;
  font-size: 28rpx;
  line-height: 1.6;
}

.tip-item::before {
  position: absolute;
  left: 0;
  top: 28rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #72a66f;
  content: "";
}

.bottom-action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  box-sizing: border-box;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(247, 251, 244, 0.96);
  box-shadow: 0 -8rpx 28rpx rgba(63, 143, 90, 0.08);
}

.bottom-add-action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  background: #3f8f5a;
  box-shadow: 0 10rpx 24rpx rgba(63, 143, 90, 0.2);
}

.bottom-add-action.added {
  background: #eaf5e9;
}

.bottom-add-action:active {
  opacity: 0.82;
}

.bottom-add-icon {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
}

.bottom-add-label {
  margin-left: 10rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.bottom-add-action.added .bottom-add-icon,
.bottom-add-action.added .bottom-add-label {
  color: #315d3c;
}
