<view class="page detail-page">
  <view wx:if="{{!food}}" class="empty-card card">
    <view class="muted-text">没有找到这个食材</view>
  </view>

  <block wx:else>
    <view class="detail-hero card">
      <view class="hero-topline">
        <view class="hero-meta">{{categoryName}}</view>
      </view>
      <view class="food-title">{{food.name}}</view>
      <view class="hero-summary">{{food.summary}}</view>
      <view class="tag-row">
        <view wx:for="{{food.tags}}" wx:key="*this" class="tag">{{item}}</view>
      </view>
    </view>

    <block wx:for="{{infoSections}}" wx:for-item="section" wx:key="title">
      <view wx:if="{{section.hasContent}}" class="info-card card">
        <view class="card-title">{{section.title}}</view>
        <view wx:if="{{section.shelfLifeItems.length}}" class="shelf-life-grid">
          <view wx:for="{{section.shelfLifeItems}}" wx:for-item="item" wx:key="label" class="shelf-life-item">
            <view class="info-label">{{item.label}}</view>
            <view class="shelf-life-value">{{item.value}}</view>
          </view>
        </view>
        <view wx:if="{{section.items.length}}" class="info-grid">
          <view wx:for="{{section.items}}" wx:for-item="item" wx:key="label" class="info-item">
            <view class="info-label">{{item.label}}</view>
            <view class="info-value">{{item.value}}</view>
          </view>
        </view>
        <view wx:if="{{section.tips.length}}" class="tips-group">
          <view class="tips-title">小贴士</view>
          <view wx:for="{{section.tips}}" wx:key="*this" class="tip-item">{{item}}</view>
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{food}}" class="bottom-action-bar">
    <view class="bottom-add-action {{isInPantry ? 'added' : ''}}" bindtap="handlePantryAction">
      <text class="bottom-add-icon">{{isInPantry ? '✓' : '+'}}</text>
      <text class="bottom-add-label">{{isInPantry ? '查看我的食材' : '加入我的食材'}}</text>
    </view>
  </view>
</view>
