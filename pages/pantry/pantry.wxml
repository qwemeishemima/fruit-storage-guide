<view class="page pantry-page">
  <view wx:if="{{!hasMyFoods}}" class="empty-card card">
    <view class="empty-icon">+</view>
    <view class="empty-title">还没有记录食材</view>
    <view class="muted-text">看到容易放坏的蔬果，可以先加入这里，方便下次查看保存状态。</view>
    <button class="placeholder-button" bindtap="goToAddFood">去首页添加</button>
  </view>

  <view wx:if="{{hasMyFoods}}" class="pantry-content">
    <view class="pantry-overview card">
      <view class="overview-main">
        <view class="overview-title">我的食材</view>
        <view class="overview-total">{{overview.totalText}}</view>
      </view>
      <view class="overview-urgent {{overview.urgentCount > 0 ? 'has-urgent' : ''}}">{{overview.urgentText}}</view>
    </view>
    <view class="pantry-note">食材会按当前状态分组，方便先处理需要尽快吃的。</view>
    <view class="pantry-groups">
      <view wx:for="{{foodGroups}}" wx:for-item="group" wx:key="key" class="pantry-group">
        <view class="group-header">
          <view class="group-title">{{group.title}}</view>
          <view class="group-count">{{group.count}}</view>
        </view>
        <view class="pantry-list">
          <view wx:for="{{group.items}}" wx:for-item="item" wx:key="recordId" class="pantry-card card" data-id="{{item.foodId}}" bindtap="goToDetail">
            <view class="pantry-main">
              <view class="pantry-header">
                <view class="pantry-name">{{item.name}}</view>
                <view class="status-pill {{item.statusType}}">{{item.statusText}}</view>
              </view>
              <view class="status-tip {{item.statusType}}">{{item.statusTip}}</view>
            </view>
            <view class="pantry-footer">
              <view class="added-date">加入：{{item.purchaseTimeText}}</view>
              <button class="delete-button" data-record-id="{{item.recordId}}" catchtap="deleteRecord">删除</button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
