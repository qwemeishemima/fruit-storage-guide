<view class="page pantry-page">
  <view wx:if="{{!hasMyFoods}}" class="empty-card card">
    <view class="empty-title">还没有添加食材</view>
    <view class="muted-text">去搜索或分类页，找到食材后点加入我的食材，就能记录保鲜期。</view>
    <button class="placeholder-button" bindtap="goToAddFood">去添加食材</button>
  </view>

  <view wx:if="{{hasMyFoods}}" class="pantry-content">
    <view class="section-title">我的食材</view>
    <view class="pantry-list">
      <view wx:for="{{myFoods}}" wx:key="recordId" class="pantry-card card">
        <view class="pantry-main" data-id="{{item.foodId}}" bindtap="goToDetail">
          <view class="pantry-name">{{item.name}}</view>
          <view class="added-date">添加日期：{{item.addedAt}}</view>
          <view class="status-pill {{item.statusType}}">{{item.statusText}}</view>
          <view class="pantry-summary">{{item.summary}}</view>
        </view>
        <button class="delete-button" data-record-id="{{item.recordId}}" catchtap="deleteRecord">删除</button>
      </view>
    </view>
  </view>
</view>
