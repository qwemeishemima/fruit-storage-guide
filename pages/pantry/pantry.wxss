.pantry-page {
  padding-top: 32rpx;
}

.empty-card {
  width: 100%;
  padding: 60rpx 38rpx;
  text-align: center;
}

.empty-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: #eaf5e9;
  color: #315d3c;
  font-size: 46rpx;
  font-weight: 500;
  line-height: 1;
}

.empty-title {
  margin-bottom: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #243126;
}

.placeholder-button {
  display: inline-block;
  margin-top: 32rpx;
  padding: 20rpx 32rpx;
  width: auto;
  height: auto;
  border-radius: 999rpx;
  background: #eaf5e9;
  color: #315d3c;
  font-size: 28rpx;
  line-height: 1.2;
}

.placeholder-button::after {
  border: none;
}

.pantry-content {
  width: 100%;
}

.pantry-overview {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
  padding: 30rpx 30rpx;
}

.overview-main {
  min-width: 0;
}

.overview-title {
  color: #243126;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
}

.overview-total {
  margin-top: 10rpx;
  color: #59685b;
  font-size: 27rpx;
  line-height: 1.4;
}

.overview-urgent {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  align-self: center;
  justify-content: center;
  box-sizing: border-box;
  max-width: 260rpx;
  min-height: 68rpx;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: #eaf5e9;
  color: #315d3c;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
}

.overview-urgent.has-urgent {
  background: #fff4d8;
  color: #8a6424;
}

.pantry-note {
  margin: 18rpx 0 22rpx;
  color: #7f8a7b;
  font-size: 25rpx;
  line-height: 1.5;
}

.pantry-groups {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.pantry-group {
  width: 100%;
}

.group-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.group-title {
  color: #384a3b;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.group-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #eef3e9;
  color: #59685b;
  font-size: 22rpx;
  line-height: 1;
}

.pantry-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.pantry-card {
  padding: 26rpx 26rpx 20rpx;
}

.pantry-main:active {
  opacity: 0.72;
}

.pantry-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.pantry-name {
  min-width: 0;
  overflow: hidden;
  color: #243126;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.added-date {
  color: #7f8a7b;
  font-size: 23rpx;
}

.status-pill {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #eef3e9;
  color: #59685b;
  font-size: 22rpx;
  line-height: 1.35;
}

.status-pill.fresh {
  background: #eaf5e9;
  color: #315d3c;
}

.status-pill.soon {
  background: #fff4d8;
  color: #8a6424;
}

.status-pill.expired {
  background: #fdecea;
  color: #9b3d32;
}

.status-pill.unknown {
  background: #f1f2eb;
  color: #7f8a7b;
}

.status-tip {
  margin-top: 14rpx;
  color: #59685b;
  font-size: 28rpx;
  line-height: 1.55;
}

.status-tip.soon {
  color: #7b5a22;
}

.status-tip.expired {
  color: #8f3b32;
}

.pantry-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1e8;
}

.pantry-footer .delete-button {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  width: auto;
  min-width: 112rpx;
  height: 48rpx;
  padding: 0 22rpx;
  border: 1rpx solid #ead9d3;
  border-radius: 999rpx;
  background: #fff8f6;
  color: #9b3d32;
  font-size: 23rpx;
  line-height: 1;
}

.pantry-footer .delete-button::after {
  border: none;
}
