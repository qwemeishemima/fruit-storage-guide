.pantry-page {
  padding-top: 32rpx;
}

.empty-card {
  width: 100%;
  padding: 56rpx 36rpx;
  text-align: center;
}

.empty-title {
  margin-bottom: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #243126;
}

.placeholder-button {
  display: inline-block;
  margin-top: 32rpx;
  padding: 20rpx 32rpx;
  width: auto;
  height: auto;
  border-radius: 999rpx;
  background: #eaf5e9;
  color: #315d3c;
  font-size: 28rpx;
  line-height: 1.2;
}

.placeholder-button::after {
  border: none;
}

.pantry-content {
  width: 100%;
}

.pantry-note {
  margin: -8rpx 0 22rpx;
  color: #7f8a7b;
  font-size: 25rpx;
  line-height: 1.5;
}

.pantry-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pantry-card {
  padding: 22rpx 24rpx 18rpx;
}

.pantry-main:active {
  opacity: 0.72;
}

.pantry-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.pantry-name {
  min-width: 0;
  overflow: hidden;
  color: #243126;
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.added-date {
  color: #7f8a7b;
  font-size: 23rpx;
}

.status-pill {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #eef3e9;
  color: #59685b;
  font-size: 22rpx;
  line-height: 1.35;
}

.status-pill.fresh {
  background: #eaf5e9;
  color: #315d3c;
}

.status-pill.soon {
  background: #fff4d8;
  color: #8a6424;
}

.status-pill.expired {
  background: #fdecea;
  color: #9b3d32;
}

.status-pill.unknown {
  background: #f1f2eb;
  color: #7f8a7b;
}

.pantry-summary {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #59685b;
  font-size: 26rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.pantry-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
}

.pantry-footer .delete-button {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  width: auto;
  min-width: 112rpx;
  height: 48rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe5d8;
  border-radius: 999rpx;
  background: transparent;
  color: #7f8a7b;
  font-size: 23rpx;
  line-height: 1;
}

.pantry-footer .delete-button::after {
  border: none;
}
