.pantry-page {
  padding-top: 32rpx;
}

.empty-card {
  width: 100%;
  padding: 56rpx 36rpx;
  text-align: center;
}

.empty-title {
  margin-bottom: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #243126;
}

.placeholder-button {
  display: inline-block;
  margin-top: 32rpx;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  background: #eaf5e9;
  color: #315d3c;
  font-size: 28rpx;
}

.pantry-content {
  width: 100%;
}

.pantry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pantry-card {
  padding: 28rpx 30rpx;
}

.pantry-main:active {
  opacity: 0.72;
}

.pantry-name {
  color: #243126;
  font-size: 34rpx;
  font-weight: 700;
}

.added-date {
  margin-top: 10rpx;
  color: #7f8a7b;
  font-size: 24rpx;
}

.status-pill {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef3e9;
  color: #59685b;
  font-size: 24rpx;
}

.status-pill.fresh {
  background: #eaf5e9;
  color: #315d3c;
}

.status-pill.soon {
  background: #fff4d8;
  color: #8a6424;
}

.status-pill.expired {
  background: #fdecea;
  color: #9b3d32;
}

.status-pill.unknown {
  background: #f1f2eb;
  color: #7f8a7b;
}

.pantry-summary {
  margin-top: 14rpx;
  color: #59685b;
  font-size: 27rpx;
  line-height: 1.6;
}

.delete-button {
  margin: 22rpx 0 0;
  padding: 0;
  width: 132rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: #f1f2eb;
  color: #7f8a7b;
  font-size: 25rpx;
  line-height: 58rpx;
}

.delete-button::after {
  border: none;
}
