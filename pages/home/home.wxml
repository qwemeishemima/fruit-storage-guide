<view class="page home-page">
  <view class="hero card">
    <view class="brand">鲜存记</view>
    <view class="slogan">查怎么存，记别放坏</view>
  </view>

  <view class="search-box" bindtap="goToSearch">
    <text class="search-placeholder">搜索蔬菜、水果怎么保存</text>
  </view>

  <view wx:if="{{categoryEntries.length}}" class="category-entry-section">
    <view class="section-title">按分类找</view>
    <view class="category-entry-grid">
      <view
        wx:for="{{categoryEntries}}"
        wx:key="id"
        class="category-entry-item"
        data-id="{{item.id}}"
        bindtap="goToCategory"
      >
        <view class="category-entry-icon" style="background: {{item.color}};">{{item.icon}}</view>
        <view class="category-entry-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <view class="quick-section">
    <view class="section-title">保鲜专题</view>
    <scroll-view class="quick-scroll" scroll-x="true" show-scrollbar="false">
      <view class="quick-row">
        <view
          wx:for="{{quickEntries}}"
          wx:key="tag"
          class="quick-item"
          data-tag="{{item.tag}}"
          bindtap="goToTag"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{todayTip}}" class="tip-section">
    <view class="section-title">今日小贴士</view>
    <view class="tip-card card">
      <view class="tip-label">保鲜小知识</view>
      <view class="tip-text">{{todayTip}}</view>
    </view>
  </view>

  <view wx:if="{{commonFoods.length}}" class="common-section">
    <view class="section-title">大家常查</view>
    <view class="common-grid">
      <view
        wx:for="{{commonFoods}}"
        wx:key="id"
        class="common-card card"
        data-id="{{item.id}}"
        bindtap="goToDetail"
      >
        <view class="common-name">{{item.name}}</view>
        <view class="common-summary">{{item.summary}}</view>
        <view class="tag-row compact">
          <view wx:for="{{item.visibleTags}}" wx:for-item="tag" wx:key="*this" class="tag compact-tag">{{tag}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
