.home-page {
  padding-top: 40rpx;
}

.hero {
  padding: 40rpx 36rpx;
}

.brand {
  font-size: 54rpx;
  font-weight: 800;
  color: #2f7d4f;
}

.slogan {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #59685b;
}

.search-box {
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #dfeadd;
  border-radius: 24rpx;
  background: #ffffff;
}

.search-box:active {
  background: #f3f8f1;
}

.search-placeholder {
  font-size: 28rpx;
  color: #9aa59a;
}

.category-entry-section {
  margin-top: 32rpx;
}

.category-entry-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.category-entry-item {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 6rpx;
  border: 1rpx solid #edf2e8;
  border-radius: 20rpx;
  background: #ffffff;
}

.category-entry-item:active {
  background: #f3f8f1;
}

.category-entry-icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #315d3c;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: inset 0 0 0 1rpx rgba(63, 143, 90, 0.08);
}

.category-entry-name {
  max-width: 100%;
  overflow: hidden;
  color: #243126;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-section {
  margin-top: 36rpx;
}

.quick-scroll {
  width: 100%;
  white-space: nowrap;
}

.quick-row {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 2rpx;
}

.quick-item {
  box-sizing: border-box;
  flex: 0 0 auto;
  padding: 14rpx 24rpx;
  border: 2rpx solid #e2eadc;
  border-radius: 999rpx;
  background: #f6f4ea;
  color: #315d3c;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}

.quick-item:active {
  background: #ece8d8;
}

.tip-section,
.common-section {
  margin-top: 36rpx;
}

.tip-card {
  padding: 24rpx 28rpx;
  border-color: #e9eadf;
  background: #fffdf4;
}

.common-card:active {
  background: #f8fbf5;
}

.tip-label {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf5e9;
  color: #315d3c;
  font-size: 22rpx;
  font-weight: 600;
}

.tip-text {
  margin-top: 14rpx;
  color: #4a584c;
  font-size: 28rpx;
  line-height: 1.55;
}

.common-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.common-card {
  min-height: 220rpx;
  box-sizing: border-box;
  padding: 24rpx 22rpx;
}

.common-name {
  color: #243126;
  font-size: 32rpx;
  font-weight: 700;
}

.common-summary {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #59685b;
  font-size: 25rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag-row.compact {
  gap: 8rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eaf5e9;
  color: #315d3c;
  font-size: 23rpx;
}

.compact-tag {
  padding: 6rpx 12rpx;
  font-size: 21rpx;
}
